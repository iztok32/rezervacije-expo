# Kopiraj v .env in prilagodi.
# Telefon mora URL doseči po omrežju: *.test (Herd) ali localhost na telefonu NE delujeta.
# Za lokalni razvoj uporabi IP računalnika, npr. http://192.168.1.20:8000
# (Laravel zaženi s: php artisan serve --host=0.0.0.0 --port=8000)
EXPO_PUBLIC_API_URL=https://kk-karlo.epro.one

# Neobvezno: drug URL samo za web različico (npx expo start --web).
# Brskalnik na tem računalniku vidi Herd *.test, zato tu lahko uporabiš lokalni Laravel.
# EXPO_PUBLIC_API_URL_WEB=http://kk-karlo-bb.test
